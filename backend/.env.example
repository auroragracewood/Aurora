# Aurora Gracewood backend environment template
# Copy to .env (gitignored) and fill real values before running.

# Where the API listens. Frontends will call this base.
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:9333,http://localhost:9333,https://auroragracewood.com

# Session signing secret (rotate periodically; never commit a real value).
SESSION_SECRET=change-me-to-a-long-random-string

# JWT signing for API tokens (separate from session secret).
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALG=HS256
JWT_TTL_HOURS=24

# Database (SQLite for dev; Postgres in production).
DATABASE_URL=sqlite:///./data/aurora.db

# When this email signs up, their role is set to "superuser" automatically.
# Mirrors the INITIAL_SUPERUSER_EMAIL constant in /account/auth.js so stub
# and real backend behave identically. Change in BOTH places if it changes.
INITIAL_SUPERUSER_EMAIL=aandrew7.am@gmail.com

# Email provider for magic-link auth (TBD: Resend / Postmark / Mailgun).
EMAIL_FROM=noreply@auroragracewood.com
EMAIL_PROVIDER=stub
EMAIL_API_KEY=

# Stripe (Phase 4).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Badge embed signing (Phase 5).
BADGE_HMAC_SECRET=change-me-for-badge-signing
